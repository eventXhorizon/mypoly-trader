# ================================================================
# polymarket-terminal - Environment Configuration
# Copy this file to .env and fill in your values.
# ================================================================


# ================================================================
# 1) Most-used settings: copy trading / simulation
# ================================================================

# DRY_RUN:
# true  = simulation only, no real orders
# false = live trading, can place/cancel real orders
# Always test with DRY_RUN=true first.
DRY_RUN=true

# EOA private key - used for SIGNING only, does NOT hold funds.
# Required for live trading. Not required for pure multi-watch simulation.
# Never share this key or commit it to version control.
PRIVATE_KEY=0xYOUR_EOA_PRIVATE_KEY_HERE

# Your Polymarket Proxy Wallet / Deposit Wallet.
# This is the address shown when you click "Deposit" on Polymarket.
# CLOB V2 trades are funded by pUSD balance associated with this wallet.
PROXY_WALLET_ADDRESS=0xYOUR_PROXY_WALLET_ADDRESS_HERE

# Single-wallet live copy trading target.
# If TRADER_ADDRESSES is empty, npm run bot / Docker live-bot watches this wallet.
TRADER_ADDRESS=0xTRADER_PROXY_WALLET_ADDRESS

# Multi-wallet targets.
# npm run bot / Docker live-bot can live-copy multiple wallets from this list.
# npm run multi-watch uses this for pure simulation; dashboard-saved settings override this.
TRADER_ADDRESSES=0x1111111111111111111111111111111111111111,0x2222222222222222222222222222222222222222

# Optional labels for target wallets shown in logs and positions.
# Format: address=label,address=label
# If omitted, labels default to W1, W2, W3...
TRADER_WALLET_LABELS=0x1111111111111111111111111111111111111111=W1,0x2222222222222222222222222222222222222222=W2

# CLOB V2 signature type:
# 0 = EOA
# 1 = POLY_PROXY (Magic Link / email / Google login proxy)
# 2 = POLY_GNOSIS_SAFE (browser wallet proxy wallet, common for injected wallet users)
# 3 = POLY_1271 (new deposit wallet flow)
CLOB_SIGNATURE_TYPE=2


# ================================================================
# 2) Trade sizing
# ================================================================

# SIZE_MODE:
# "percentage" = SIZE_PERCENT% of MAX_POSITION_SIZE per outcome entry
# "balance"    = SIZE_PERCENT% of your current pUSD balance per entry
#
# For fixed 2U live copy entries, use:
# SIZE_MODE=percentage
# SIZE_PERCENT=100
# MAX_POSITION_SIZE=2
SIZE_MODE=balance
SIZE_PERCENT=10

# Minimum trade size in pUSD. Skip if calculated size is below this.
# Polymarket CLOB also has a practical minimum order size, so 1 is recommended.
MIN_TRADE_SIZE=1

# Maximum total pUSD position per tracked wallet + concrete outcome/token.
# This is not a whole-topic cap. A multi-outcome topic can have multiple caps.
# Example: MAX_POSITION_SIZE=2 means option A can use 2U, option B can use 2U,
# and option C can use 2U independently.
MAX_POSITION_SIZE=10


# ================================================================
# 3) Sell behavior and safety limits
# ================================================================

# false = pure copy mode: buy when target buys, sell when target sells
# true  = after buying, also place an automatic take-profit sell order
AUTO_SELL_ENABLED=true
AUTO_SELL_PROFIT_PERCENT=10

# "market" = sell immediately at market price
# "limit"  = place limit order at trader's sell price
SELL_MODE=market

# Do not buy markets that are too close to expiry.
MIN_MARKET_TIME_LEFT=300

# FAK order retry settings.
# Lower these if you want to fall back to GTC faster when there is no immediate liquidity.
ORDER_MAX_RETRIES=5
ORDER_RETRY_DELAY_MS=3000

# Allowed price drift from target trader price.
# BUY 2 means bid up to trader_price * 1.02.
# SELL 2 means ask down to trader_price * 0.98.
BUY_SLIPPAGE_PERCENT=2
SELL_SLIPPAGE_PERCENT=2

# If FAK has no liquidity, place a GTC fallback order and wait this many seconds.
# BUY/SELL-specific values override GTC_FALLBACK_TIMEOUT.
# Set SELL_GTC_FALLBACK_TIMEOUT=0 if you do not want resting sell orders.
GTC_FALLBACK_TIMEOUT=60
BUY_GTC_FALLBACK_TIMEOUT=60
SELL_GTC_FALLBACK_TIMEOUT=60

# How often to check open positions for redemption after market resolution.
REDEEM_INTERVAL=60


# ================================================================
# 4) Dashboard and database
# ================================================================

# Web dashboard.
# npm run multi-watch uses WEB_PORT by default.
# Docker live-bot overrides WEB_PORT to 8788 to avoid conflicting with multi-watch.
WEB_HOST=0.0.0.0
WEB_PORT=8787

# Paper starting balance for simulation modes.
# Used by npm start / npm run bot-sim when DRY_RUN=true, and by npm run multi-watch.
# For multi-watch, dashboard-saved settings override this default.
SIM_START_BALANCE=100

# Postgres database for multi-watch PnL history.
# Start it with: docker compose up -d postgres
DATABASE_URL=postgres://polymarket:polymarket_dev_password@127.0.0.1:15432/polymarket_terminal
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_MS=5000
PNL_SNAPSHOT_INTERVAL=60
PNL_HISTORY_LIMIT=100
MULTI_WATCH_REQUIRE_DB=true

# Wallet analytics / candidate scoring (npm run wallet-score).
# Stage 1A uses public Data API trades + closed positions only.
WALLET_ANALYTICS_TRADES_PATH=/trades
WALLET_ANALYTICS_CLOSED_POSITIONS_PATH=/v1/closed-positions
WALLET_ANALYTICS_TRADE_LIMIT=500
WALLET_ANALYTICS_CLOSED_POSITION_LIMIT=500
WALLET_ANALYTICS_PAGE_LIMIT=100
WALLET_ANALYTICS_MIN_TRADES=50
WALLET_ANALYTICS_MIN_SETTLED_MARKETS=30
WALLET_ANALYTICS_MIN_PROFIT_FACTOR=1.2
WALLET_ANALYTICS_MAX_DRAWDOWN=0.30
WALLET_ANALYTICS_MAX_TOP_MARKET_PROFIT_SHARE=0.40
WALLET_ANALYTICS_ENABLE_CLV=true
WALLET_ANALYTICS_CLV_LIMIT=80
WALLET_ANALYTICS_CLV_WINDOW_MINUTES=30
WALLET_ANALYTICS_PRICE_HISTORY_FIDELITY=5
WALLET_ANALYTICS_ORDERBOOK_LIMIT=40


# ================================================================
# 5) Network and API credentials
# ================================================================

# Public Polygon RPC (default, no key required).
POLYGON_RPC_URL=https://polygon.lava.build

# Alternative RPCs:
# POLYGON_RPC_URL=https://polygon-rpc.com
# POLYGON_RPC_URL=https://rpc.ankr.com/polygon

# Polymarket API credentials are optional.
# Leave blank to auto-derive from your private key on first run.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Optional proxy for Polymarket API only, not Polygon RPC.
# Supports HTTP, HTTPS, and SOCKS5 proxies.
# Example: http://user:pass@proxy.example.com:8080
PROXY_URL=


# ================================================================
# 6) Advanced strategy: Maker Rebate MM (npm run maker-mm-bot)
# ================================================================

# Assets to market-make (comma-separated slugs: btc, eth, sol, xrp).
MAKER_MM_ASSETS=btc

# Market duration to target: "5m" or "15m".
MAKER_MM_DURATION=15m

# Number of shares per side per cycle (minimum 5).
# Total USDC deployed per cycle ~= MAKER_MM_TRADE_SIZE * combined_price.
MAKER_MM_TRADE_SIZE=5

# Maximum combined bid (YES + NO) - controls spread profit.
# 0.98 combined = 0.02 profit per share when both fill.
MAKER_MM_MAX_COMBINED=0.98

# Reprice check interval (seconds).
MAKER_MM_REPRICE_SEC=10

# Minimum bid drift before repricing.
MAKER_MM_REPRICE_THRESHOLD=0.02

# Seconds to wait for the second side to fill after the first side fills.
MAKER_MM_FILL_TIMEOUT=120

# Seconds before market close to force-exit open positions.
MAKER_MM_CUT_LOSS_TIME=60

# Max seconds after market open to enter.
MAKER_MM_ENTRY_WINDOW=45

# How often to poll for new markets (seconds).
MAKER_MM_POLL_INTERVAL=5

# Delay between re-entry cycles within the same market (seconds).
MAKER_MM_REENTRY_DELAY=30

# Set false to disable re-entry.
MAKER_MM_REENTRY_ENABLED=true

# YES bid price range.
# NO bid is derived from MAX_COMBINED - YES bid, and is not range-filtered.
MAKER_MM_MIN_PRICE=0.30
MAKER_MM_MAX_PRICE=0.69

# Cancel cheap side when expensive side fills first, then hold and redeem.
MAKER_MM_CANCEL_CHEAP_ON_EXP_FILL=false

# Price polling interval while waiting for entry conditions.
MAKER_MM_POLL_SEC=3

# Allow entering markets that are already in progress.
CURRENT_MARKET_ENABLED=true

# Maximum odds to allow entry into a running market.
CURRENT_MARKET_MAX_ODDS=0.70

# Maximum odds to allow entry into the next market.
NEXT_MARKET_MAX_ODDS=0.52


# ================================================================
# 7) Advanced strategy: Orderbook Sniper (npm run sniper)
# ================================================================

# Comma-separated assets to snipe.
SNIPER_ASSETS=eth,sol,xrp

# 3-tier pricing.
SNIPER_TIER1_PRICE=0.03
SNIPER_TIER2_PRICE=0.02
SNIPER_TIER3_PRICE=0.01

# Max total shares to deploy.
SNIPER_MAX_SHARES=15

# Time-based sizing multiplier (UTC+8). Format: HH:MM-HH:MM:factor,...
SNIPER_MULTIPLIERS=21:00-00:00:1.41,06:00-12:00:0.85

# Rounds to pause an asset after detecting a win.
SNIPER_PAUSE_ROUNDS_AFTER_WIN=3

# Active session schedules per asset (UTC+8). Format: HH:MM-HH:MM,...
SNIPER_SCHEDULE_BTC=19:40-22:40,03:40-06:10
SNIPER_SCHEDULE_ETH=11:40-15:40,16:40-19:40
SNIPER_SCHEDULE_SOL=09:40-12:40,21:40-23:40
SNIPER_SCHEDULE_XRP=18:40-20:40,08:40-09:50


# ================================================================
# 8) Advanced strategy: Classic Market Maker (npm run mm-bot)
# ================================================================

MM_ASSETS=btc
MM_DURATION=5m
MM_TRADE_SIZE=5
MM_SELL_PRICE=0.60
MM_CUT_LOSS_TIME=60
MM_MARKET_KEYWORD=Bitcoin Up or Down
MM_ENTRY_WINDOW=45
MM_POLL_INTERVAL=10
MM_DEFENSIVE_ENABLED=true
MM_DEFENSIVE_TIMEOUT=120
MM_DEFENSIVE_WORST_THRESHOLD=0.10
MM_RECOVERY_BUY=false
MM_RECOVERY_THRESHOLD=0.70
MM_RECOVERY_SIZE=0
MM_ADAPTIVE_CL=true
MM_ADAPTIVE_MIN_COMBINED=1.20
MM_ADAPTIVE_MONITOR_SEC=5
